{
  "name": "ceyteq-digital-race",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:seed": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed.ts",
    "db:reset": "node -e \"require('node:fs').rmSync('.data',{recursive:true,force:true})\" && npm run db:seed",
    "db:stats": "NODE_OPTIONS=--conditions=react-server tsx scripts/db-stats.ts",
    "db:schema": "NODE_OPTIONS=--conditions=react-server tsx scripts/export-schema.ts",
    "logo": "node scripts/prepare-logo.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^15.5.28",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
