# ---------------------------------------------------------------------------
# Ceyteq Digital Race — environment
# Copy to `.env` and fill in. `npm run setup` generates the local SQLite
# database used for offline development.
# ---------------------------------------------------------------------------

# Leave blank in development to use the embedded PGlite PostgreSQL.
DATABASE_URL=""
# Optional: where the embedded database files live (default .data/pglite)
PGLITE_DATA_DIR=".data/pglite"

# Production (Supabase / any managed PostgreSQL). Paste the pooled connection
# string from Supabase → Project settings → Database → Connection pooling.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# Session signing + admin bootstrap credentials
AUTH_SECRET="change-me-to-a-long-random-string"
ADMIN_EMAIL="admin@ceyteq.com"
ADMIN_PASSWORD="Ceyteq@2026"
ADMIN_NAME="Ceyteq Admin"

# Public origin used for shareable form links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
