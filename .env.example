# ---------------------------------------------------------------------------
# Ceyteq Digital Race — environment template
#
#   cp .env.example .env        (local development)
#
# Locally you can leave DATABASE_URL empty: the app then runs the embedded
# PGlite database under .data/pglite. Production requires PostgreSQL.
#
# Nothing in this file is a secret. Every value below must be generated or
# copied from your provider dashboard. Never commit a filled-in `.env`.
# ---------------------------------------------------------------------------

# ── Database ───────────────────────────────────────────────────────────────
# Local: leave empty to use the embedded PGlite engine.
DATABASE_URL=""
PGLITE_DATA_DIR=".data/pglite"

# Production (Supabase → Project settings → Database → Connection pooling).
# Use the *pooler* host and keep `sslmode=require`.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# ── Session signing ────────────────────────────────────────────────────────
# Required in production, minimum 32 characters. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=""

# ── Single administrator ───────────────────────────────────────────────────
# The whole admin console is protected by ONE password. Set ADMIN_PASSWORD to a
# long random value and sign in with it at /admin/login (the email field is
# optional). This is a server-side secret: never prefix it with NEXT_PUBLIC_.
#   openssl rand -base64 32
# ADMIN_EMAIL is optional — when set, the master login also has to match it.
# A hashed database account (seeded by `npm run db:seed`) keeps working as a
# fallback, so removing ADMIN_PASSWORD never locks you out of that account.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Ceyteq Administrator"

# ── Public URLs ────────────────────────────────────────────────────────────
# Canonical origin for share links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# In production: NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# ── Supabase realtime (optional) ───────────────────────────────────────────
# The anon key is safe to expose: it can only read the PII-free
# `ceyteq_signals` table (see supabase/realtime.sql). The dashboard uses it to
# know when to refresh. Leave empty to run without live updates.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma separated extra origins allowed to POST to /api/*.
# Same-origin, *.vercel.app and *.e2b.app preview hosts are always allowed.
ALLOWED_ORIGINS=""

# ── Distributed rate limiting (optional but recommended) ───────────────────
# Create a free Upstash Redis database, then copy the REST URL + token.
# Without these the limiter falls back to per-instance in-memory counters,
# which are not shared across serverless invocations.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
